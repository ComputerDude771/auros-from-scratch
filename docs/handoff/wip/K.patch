+/* "Show me how to do things": the step-by-step pages, from the one place
+ * docs/EASY.md rule 7 says help lives. Bottom-left of the panel, right
+ * above the Help button she has just pressed, so it is where her eyes
+ * and her hand already are. Its height grows with her text size like
+ * the band's does, and never drops under the 44px floor. */
+#define FOOT_HOVER_HELP_PAGES (-200)
+static const char HELP_PAGES_LABEL[] = "Show me how to do things";
+
+int foot_help_button(const shell_ctx *c, int sw, int sh, rect *out)
+{
+    if (!c || !out || !c->have_help_pages || c->kiosk) return 0;
+    int h = foot_height(c);
+    if (h <= 0) return 0;
+    int top = sh - h;
+    float k = c->text_scale < 1.f ? 1.f : c->text_scale;
+    int gx = sw / 12; if (gx < 20) gx = 20;
+    int bh = (int)(60.f * k); if (bh < FOOT_TARGET) bh = FOOT_TARGET;
+    int bw = (int)(440.f * k);
+    if (bw > sw - 2 * gx) bw = sw - 2 * gx;
+    if (bw < FOOT_TARGET) bw = FOOT_TARGET;
+    int by = top - bh - (int)(24.f * k);
+    if (by < 0) by = 0;
+    *out = (rect){ gx, by, bw, bh };
+    return 1;
+}
