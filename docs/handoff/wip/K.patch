+/* ── 4. the way on, to the step-by-step pages ───────────────────── */
+
+/* The help panel's one button opens the help pages (the host does the
+ * opening; the panel only asks). It must still be a way OUT as well:
+ * the press closes the panel, and every other press or key still just
+ * closes it, asking for nothing. */
+static void help_pages(void)
+{
+    printf("\n  help leads to the step-by-step pages, and still closes\n");
+    shell_ctx c; fresh(&c);
+    c.have_help_pages = 1;
+    rect hb;
+    int full_h = c.screen_h + foot_height(&c);
+    ok("the help panel has the pages button",
+       foot_help_button(&c, c.screen_w, full_h, &hb) == 1);
+
+    foot_open_only(&c, &c.help_open);
+    ok("pressing it asks for the pages and closes help",
+       foot_click(&c, hb.x + hb.w / 2, hb.y + hb.h / 2) &&
+       c.want_help_pages == 1 && !c.help_open);
+
+    fresh(&c); c.have_help_pages = 1;
+    foot_open_only(&c, &c.help_open);
+    ok("a press anywhere else closes help and asks for nothing",
+       foot_click(&c, c.screen_w - 5, 5) && !c.help_open && !c.want_help_pages);
+
+    fresh(&c); c.have_help_pages = 1;
+    foot_open_only(&c, &c.help_open);
+    ok("Return presses it", foot_key(&c, K_RET) && c.want_help_pages && !c.help_open);
+
+    fresh(&c); c.have_help_pages = 1;
+    foot_open_only(&c, &c.help_open);
+    ok("any other key closes help and asks for nothing",
+       foot_key(&c, 30 /* 'a' */) && !c.help_open && !c.want_help_pages);
+
+    fresh(&c); c.have_help_pages = 1; c.kiosk = 1;
+    ok("a kiosk never offers it (a browser would get round its list)",
+       foot_help_button(&c, c.screen_w, full_h, &hb) == 0);
+
+    fresh(&c); c.have_help_pages = 0;
+    foot_open_only(&c, &c.help_open);
+    ok("no pages on the machine: no button, and Return just closes help",
+       foot_help_button(&c, c.screen_w, full_h, &hb) == 0 &&
+       foot_key(&c, K_RET) && !c.help_open && !c.want_help_pages);
+}
