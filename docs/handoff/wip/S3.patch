diff --git a/build/hardening.sh b/build/hardening.sh
new file mode 100644
index 0000000..d709a92
--- /dev/null
+++ b/build/hardening.sh
@@ -0,0 +1,36 @@
+# shellcheck shell=sh
+# hardening.sh -- the compiler flags every AurOS C program is built with.
+#
+# Sourced by build/forge (programs in the image) and build/staging (the
+# static programs in the staging environment). One file, so the two can
+# never drift apart, and so tools/cflagstest.sh has one thing to check
+# the binaries against.
+#
+# Ubuntu's gcc already turns most of these on by default, which is
+# exactly why they are written down: a default is a property of the
+# build host, and the day the image is built with a different compiler
+# or distribution they would quietly go away. Written here, they are a
+# property of AurOS.
+#
+#   _FORTIFY_SOURCE=3           size-checked memcpy/snprintf/... where the
+#                               size is known, even dynamically (needs -O)
+#   -fstack-protector-strong    canaries on every function with an array
+#                               or an address-taken local
+#   -fstack-clash-protection    a huge alloca/VLA cannot jump the guard page
+#   -fcf-protection=full        Intel CET: IBT landing pads + shadow stack
+#                               markings (used where the CPU and kernel do)
+#   -fPIE -pie / -static-pie    the program itself is randomised (ASLR)
+#   -z relro -z now             relocations resolved at start, then the
+#                               GOT is read-only: no GOT overwrite
+#   -frecord-gcc-switches       the flags each object was REALLY compiled
+#                               with go into the binary, so cflagstest can
+#                               prove them instead of trusting this file
+#
+# Cost: a few percent at most on string-heavy code, nothing measurable in
+# a shell that spends its time blending pixels.
+HARDEN_CFLAGS="-O2 -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=3 -fstack-protector-strong -fstack-clash-protection -fcf-protection=full -frecord-gcc-switches"
+HARDEN_PIE="-fPIE -pie -Wl,-z,relro,-z,now"
+# PID 1 of the staging environment and its splash are static on purpose
+# (they must not depend on the build host's libraries). static-pie keeps
+# that and still randomises where they load.
+HARDEN_STATIC="-fPIE -static-pie -Wl,-z,relro,-z,now"
