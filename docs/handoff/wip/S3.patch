diff --git a/tools/cflagstest.sh b/tools/cflagstest.sh
new file mode 100644
index 0000000..ee6bd3c
--- /dev/null
+++ b/tools/cflagstest.sh
@@ -0,0 +1,182 @@
+#!/bin/sh
+# cflagstest.sh -- are AurOS's own programs really built hardened?
+#
+# build/hardening.sh says which flags every C program gets. This checks
+# the BINARIES, not the build script, because a flag that is written
+# down and then lost on the way to the compiler (a second gcc line
+# somebody adds, a CC override, a different distribution's defaults)
+# protects nothing. Per ELF file:
+#
+#   PIE        ELF type DYN (static programs: static-pie)      -fPIE -pie
+#   RELRO      a GNU_RELRO segment                             -z relro
+#   BIND_NOW   DT_FLAGS BIND_NOW / FLAGS_1 NOW                 -z now
+#   NX stack   GNU_STACK without E
+#   CET        .note.gnu.property x86 feature IBT and SHSTK    -fcf-protection=full
+#   switches   .GCC.command.line present, and every compile unit it
+#              records has -fstack-protector-strong,
+#              -fstack-clash-protection, -fcf-protection=full and -fPIE
+#   FORTIFY    at least one __*_chk call                       _FORTIFY_SOURCE
+#              (gcc does not record -D options, so this is the
+#              evidence; programs with no symbol table are exempt)
+#
+#   sh tools/cflagstest.sh FILE...          check these programs
+#   sh tools/cflagstest.sh --rootfs DIR     AurOS's programs in an image tree
+#   sh tools/cflagstest.sh --staging DIR    the staging environment's
+#   sh tools/cflagstest.sh --self-test      prove every check above fails
+#                                           when its flag is removed
+#
+# Exit 0 only if every file passes.
+set -u
+HERE=$(cd "$(dirname "$0")" && pwd)
+ROOT=$(cd "$HERE/.." && pwd)
+
+for t in readelf nm; do
+    command -v "$t" >/dev/null 2>&1 || { echo "FAIL: $t not installed (binutils)"; exit 2; }
+done
+
+# Prints the reasons a file is not hardened, one per line; nothing if it is.
+reasons() {
+    f=$1
+    if ! hdr=$(readelf -hW "$f" 2>/dev/null); then echo "not an ELF file"; return; fi
+    case "$hdr" in *"Type:"*"DYN"*) ;; *) echo "not PIE (ELF type is not DYN)";; esac
+    ph=$(readelf -lW "$f" 2>/dev/null)
+    printf '%s\n' "$ph" | grep -q 'GNU_RELRO' || echo "no RELRO segment (-z relro)"
+    dyn=$(readelf -dW "$f" 2>/dev/null)
+    printf '%s\n' "$dyn" | grep -Eq 'BIND_NOW|Flags:.* NOW' || echo "no BIND_NOW (-z now)"
+    st=$(printf '%s\n' "$ph" | awk '$1 == "GNU_STACK" { print $7 }')
+    case "$st" in
+        "") echo "no GNU_STACK header (stack executable by default)" ;;
+        *E*) echo "executable stack" ;;
+    esac
+    cet=$(readelf -nW "$f" 2>/dev/null | grep 'x86 feature' || true)
+    case "$cet" in *IBT*) ;; *) echo "no CET IBT marking (-fcf-protection=full)";; esac
+    case "$cet" in *SHSTK*) ;; *) echo "no CET SHSTK marking (-fcf-protection=full)";; esac
+
+    sw=$(readelf -p .GCC.command.line "$f" 2>/dev/null | grep 'GNU C' || true)
+    if [ -z "$sw" ]; then
+        echo "no recorded compile switches (built without build/hardening.sh?)"
+    else
+        # The LAST option of each family is the one gcc obeys, and the
+        # distribution's implicit defaults are recorded too, so
+        # "-fstack-protector-strong ... -fno-stack-protector" must fail.
+        printf '%s\n' "$sw" | awk '
+            {
+                ssp = clash = cf = pie = ""
+                for (i = 1; i <= NF; i++) {
+                    t = $i
+                    if (t ~ /^-f(no-)?stack-protector(-strong|-all|-explicit)?$/) ssp = t
+                    else if (t ~ /^-f(no-)?stack-clash-protection$/)          clash = t
+                    else if (t ~ /^-fcf-protection(=.*)?$/)                    cf = t
+                    else if (t ~ /^-f(no-)?(PIE|pie|PIC|pic)$/)                 pie = t
+                }
+                if (ssp != "-fstack-protector-strong" && ssp != "-fstack-protector-all") bad["-fstack-protector-strong"] = 1
+                if (clash != "-fstack-clash-protection") bad["-fstack-clash-protection"] = 1
+                if (cf != "-fcf-protection=full" && cf != "-fcf-protection") bad["-fcf-protection=full"] = 1
+                if (pie !~ /^-f(PIE|pie|PIC|pic)$/) bad["-fPIE"] = 1
+            }
+            END { for (k in bad) print "a compile unit lacks " k }' | sort
+    fi
+
+    syms=$(nm -D "$f" 2>/dev/null; nm "$f" 2>/dev/null)
+    if [ -n "$syms" ]; then
+        # A whole symbol ending in _chk (__memcpy_chk, __snprintf_chk...),
+        # not __stack_chk_fail, which the stack protector brings in alone.
+        printf '%s\n' "$syms" | grep -E ' __[a-z0-9_]+_chk(@.*)?$' | grep -vq '__stack_chk' || \
+            echo "no __*_chk calls (_FORTIFY_SOURCE off)"
+    fi
+}
+
+check() {
+    bad=0
+    for f in "$@"; do
+        if [ ! -f "$f" ]; then echo "FAIL  $f: missing"; bad=$((bad + 1)); continue; fi
+        r=$(reasons "$f")
+        if [ -z "$r" ]; then echo "ok    $f"
+        else
+            echo "FAIL  $f"
+            printf '%s\n' "$r" | sed 's/^/        /'
+            bad=$((bad + 1))
+        fi
+    done
+    return $bad
+}
+
+# The programs AurOS builds from its own sources. Keep in step with the
+# gcc lines in build/forge and build/staging.
+ROOTFS_PROGS="usr/sbin/aurinit usr/bin/aurctl usr/bin/aurwall usr/bin/aursorry
+usr/sbin/aurfirst usr/bin/aurshell usr/lib/ferry/ferry-hivepeek usr/lib/ferry/ferry-winattr"
+STAGING_PROGS="init usr/bin/aurscreen"
+
+self_test() {
+    . "$ROOT/build/hardening.sh"
+    d=$(mktemp -d "${TMPDIR:-/tmp}/cflagstest.XXXXXX") || exit 2
+    trap 'rm -rf "$d"' EXIT
+    cat > "$d/p.c" <<'EOF'
+#include <stdio.h>
+#include <string.h>
+int main(int argc, char **argv)
+{
+    char b[16];
+    strcpy(b, argc > 1 ? argv[1] : "x");   /* __strcpy_chk under FORTIFY */
+    puts(b);
+    return 0;
+}
+EOF
+    CC=${CC:-cc}
+    pass=0; fail=0
+    expect() {   # name, "ok" or reason substring, compiler flags...
+        name=$1; want=$2; shift 2
+        # shellcheck disable=SC2068
+        if ! $CC "$@" -o "$d/$name" "$d/p.c" 2>"$d/$name.log"; then
+            echo "FAIL  self-test $name: did not compile"; sed 's/^/        /' "$d/$name.log"
+            fail=$((fail + 1)); return
+        fi
+        r=$(reasons "$d/$name")
+        if [ "$want" = ok ]; then
+            if [ -z "$r" ]; then pass=$((pass + 1)); echo "ok    self-test $name: passes"
+            else echo "FAIL  self-test $name: should pass but:"; printf '%s\n' "$r" | sed 's/^/        /'; fail=$((fail + 1)); fi
+        else
+            case "$r" in
+                *"$want"*) pass=$((pass + 1)); echo "ok    self-test $name: refused ($want)" ;;
+                *) echo "FAIL  self-test $name: not refused for '$want'"; [ -n "$r" ] && printf '%s\n' "$r" | sed 's/^/        /'
+                   fail=$((fail + 1)) ;;
+            esac
+        fi
+    }
+    # shellcheck disable=SC2086
+    {
+    expect hardened        ok                         $HARDEN_CFLAGS $HARDEN_PIE
+    expect hardened-static ok                         $HARDEN_CFLAGS $HARDEN_STATIC
+    expect no-pie          "not PIE"                  $HARDEN_CFLAGS -fno-PIE -no-pie -Wl,-z,relro,-z,now
+    expect plain-static    "not PIE"                  $HARDEN_CFLAGS -static
+    expect lazy            "no BIND_NOW"              $HARDEN_CFLAGS -fPIE -pie -Wl,-z,relro,-z,lazy
+    expect norelro         "no RELRO"                 $HARDEN_CFLAGS -fPIE -pie -Wl,-z,norelro,-z,now
+    expect execstack       "executable stack"         $HARDEN_CFLAGS $HARDEN_PIE -Wl,-z,execstack
+    expect no-cet          "no CET IBT"               $HARDEN_CFLAGS -fcf-protection=none $HARDEN_PIE
+    expect no-ssp          "lacks -fstack-protector-strong" $HARDEN_CFLAGS -fno-stack-protector $HARDEN_PIE
+    expect no-clash        "lacks -fstack-clash-protection" $HARDEN_CFLAGS -fno-stack-clash-protection $HARDEN_PIE
+    expect no-fortify      "_FORTIFY_SOURCE off"      $HARDEN_CFLAGS -U_FORTIFY_SOURCE $HARDEN_PIE
+    expect no-record       "no recorded compile switches" -O2 -D_FORTIFY_SOURCE=3 -fstack-protector-strong \
+                                                      -fstack-clash-protection -fcf-protection=full $HARDEN_PIE
+    }
+    echo "self-test: $pass ok, $fail failed"
+    [ $fail -eq 0 ]
+}
+
+case "${1:-}" in
+    --self-test) self_test; exit $? ;;
+    --rootfs|--staging)
+        [ $# -eq 2 ] || { echo "usage: $0 $1 DIR"; exit 2; }
+        [ "$1" = --rootfs ] && list=$ROOTFS_PROGS || list=$STAGING_PROGS
+        set -- "$2" $list
+        dir=$1; shift
+        files=""
+        for p in "$@"; do files="$files $dir/$p"; done
+        # shellcheck disable=SC2086
+        check $files; n=$?
+        ;;
+    ""|-h|--help) sed -n '2,30p' "$0"; exit 2 ;;
+    *) check "$@"; n=$? ;;
+esac
+[ $n -eq 0 ] && echo "PASS: hardened" || echo "FAIL: $n program(s) not hardened"
+exit $n
