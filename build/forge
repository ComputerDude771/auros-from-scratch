#!/bin/bash
# ═══════════════════════════════════════════════════════════════════
#  forge — the AurOS image builder
#
#  Reads a profile and produces a bootable system. One profile file is
#  the entire customization surface: branding, theme, locale, app set,
#  lockdown policy. Changing what an organisation ships should never
#  mean changing code.
#
#    forge build   PROFILE      run every stage
#    forge stage   PROFILE N    run one stage (for iterating)
#    forge list                 list profiles
#    forge shell   PROFILE      chroot into the built rootfs
#    forge clean   PROFILE
# ═══════════════════════════════════════════════════════════════════
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROFILE_DIR="$ROOT/profiles"
WORK="$ROOT/work/forge"
OUT="$ROOT/out"

C_OK=$'\033[38;2;125;211;192m'; C_ERR=$'\033[38;2;242;120;141m'
C_DIM=$'\033[38;2;110;120;134m'; C_RST=$'\033[0m'
say()  { printf '%s::%s %s\n' "$C_OK"  "$C_RST" "$*"; }
step() { printf '\n%s▸%s %s\n' "$C_OK" "$C_RST" "$*"; }
note() { printf '%s   %s%s\n' "$C_DIM" "$*" "$C_RST"; }
die()  { printf '%s::%s %s\n' "$C_ERR" "$C_RST" "$*" >&2; exit 1; }

# ── profile loading, with single-parent inheritance ────────────────
load_profile() {
    local name=$1 chain="" cur=$1 depth=0 f
    while [ -n "$cur" ]; do
        f="$PROFILE_DIR/$cur.profile"
        [ -f "$f" ] || f="$cur"
        [ -f "$f" ] || die "no such profile: $cur"
        case " $chain " in *" $f "*) die "profile inherit cycle at $cur" ;; esac
        chain="$f $chain"
        cur=$(sed -n 's/^[[:space:]]*inherit="\{0,1\}\([A-Za-z0-9_-]*\)"\{0,1\}.*/\1/p' "$f" | head -1)
        depth=$((depth+1)); [ $depth -gt 8 ] && die "inherit chain too deep"
    done
    for f in $chain; do
        # shellcheck disable=SC1090
        source "$f"
    done
    unset inherit 2>/dev/null || true
    PROFILE="$name"
    RFS="$WORK/$profile_id/rootfs"
}

# Every chroot command runs with the API filesystems mounted and
# services prevented from starting (policy-rc.d), which is what stops a
# package's postinst from trying to talk to a systemd that isn't there.
chroot_prep() {
    mkdir -p "$RFS"/{proc,sys,dev,dev/pts,run}
    mountpoint -q "$RFS/proc"    || mount -t proc  proc    "$RFS/proc"
    mountpoint -q "$RFS/sys"     || mount -t sysfs sysfs   "$RFS/sys"
    mountpoint -q "$RFS/dev"     || mount --bind /dev      "$RFS/dev"
    mountpoint -q "$RFS/dev/pts" || mount -t devpts devpts "$RFS/dev/pts"
    printf '#!/bin/sh\nexit 101\n' > "$RFS/usr/sbin/policy-rc.d"
    chmod +x "$RFS/usr/sbin/policy-rc.d"
    cp /etc/resolv.conf "$RFS/etc/resolv.conf" 2>/dev/null || true
}
chroot_done() {
    # Guard: the EXIT trap fires even on paths that never loaded a
    # profile (forge list), where RFS is unset.
    [ -n "${RFS:-}" ] || return 0
    rm -f "$RFS/usr/sbin/policy-rc.d"
    for m in dev/pts dev sys proc; do
        mountpoint -q "$RFS/$m" && umount -lf "$RFS/$m" || true
    done
}
trap 'chroot_done 2>/dev/null || true' EXIT

inchroot() {
    chroot "$RFS" /usr/bin/env -i \
        HOME=/root PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
        DEBIAN_FRONTEND=noninteractive LC_ALL=C \
        ${http_proxy:+http_proxy="$http_proxy"} \
        ${https_proxy:+https_proxy="$https_proxy"} \
        /bin/bash -c "$*"
}

# ── stage 1: bootstrap the base ────────────────────────────────────
stage_bootstrap() {
    step "stage 1/7  bootstrap $base_suite"
    if [ -f "$RFS/.forge-bootstrapped" ]; then
        note "already bootstrapped; skipping"; return 0
    fi
    rm -rf "$RFS"; mkdir -p "$RFS"
    debootstrap --arch=amd64 --variant=minbase \
        --components="$(echo "$base_components" | tr ' ' ',')" \
        "$base_suite" "$RFS" "$base_mirror"

    cat > "$RFS/etc/apt/sources.list" <<EOL
deb $base_mirror $base_suite $base_components
deb $base_mirror $base_suite-updates $base_components
deb http://security.ubuntu.com/ubuntu $base_suite-security $base_components
EOL
    touch "$RFS/.forge-bootstrapped"
    note "base is $(du -sh "$RFS" | cut -f1)"
}

# ── stage 2: packages ──────────────────────────────────────────────
stage_packages() {
    step "stage 2/7  packages"
    chroot_prep
    local pkgs="$packages_hardware $packages_boot $packages_base $packages_desktop $packages_apps $packages_extra"
    pkgs=$(echo "$pkgs" | tr -s ' \n' ' ')
    note "installing: $(echo "$pkgs" | wc -w) packages"
    inchroot "apt-get update -qq"
    inchroot "apt-get install -y --no-install-recommends $pkgs" \
        || die "package install failed — see the log above"
    [ -n "${packages_exclude:-}" ] && \
        inchroot "apt-get purge -y $packages_exclude 2>/dev/null || true"

    stage_browser
    inchroot "apt-get clean; rm -rf /var/lib/apt/lists/*"
    chroot_done
}

# ── browser: never let a desktop ship without one, silently ───────
#
# The preferred source is Mozilla's own apt repository, because Ubuntu's
# `firefox` is a transitional package that pulls in snapd, and this
# build purges snapd. If that repository cannot be reached from the
# build host -- a proxy, an air gap, a blocked domain -- the image falls
# back to a real browser from Ubuntu's own archive rather than shipping
# with none. A person who downloads an operating system and finds it
# cannot open a web page does not care which network the builder was on.
install_browser_pkg() {
    inchroot "apt-get install -y --no-install-recommends $1" >/dev/null 2>&1
}

stage_browser_fallback() {
    local why="$1" fb="${browser_fallback:-}"
    if [ -z "$fb" ]; then
        MISSING_BROWSER=1
        printf '%s\n' "browser=MISSING" >> "$RFS/etc/auros/build-warnings"
        say "${C_ERR}WARNING${C_RST}: $why, and no browser_fallback is set."
        note "The image will have NO BROWSER. Do not ship this image."
        return 0
    fi
    say "${C_ERR}NOTE${C_RST}: $why."
    note "Falling back to $fb from the Ubuntu archive."
    if install_browser_pkg "$fb"; then
        printf '%s\n' "browser=$fb (fallback; $why)" >> "$RFS/etc/auros/build-warnings"
        note "$fb installed — the desktop has a working browser"
    else
        MISSING_BROWSER=1
        printf '%s\n' "browser=MISSING" >> "$RFS/etc/auros/build-warnings"
        say "${C_ERR}WARNING${C_RST}: the fallback browser $fb also failed to install."
        note "The image will have NO BROWSER. Do not ship this image."
    fi
}

stage_browser() {
    case "${browser_source:-none}" in
      none|"") note "no browser requested"; return 0 ;;
      archive)
        install_browser_pkg "$browser" \
            && { note "$browser installed from the Ubuntu archive"; return 0; }
        stage_browser_fallback "$browser is not installable from the archive"
        return 0 ;;
      snap)
        inchroot "apt-get install -y --no-install-recommends snapd $browser" \
            && { note "$browser installed via snap"; return 0; }
        stage_browser_fallback "the snap install of $browser failed"
        return 0 ;;
      mozilla-apt) ;;
      *) die "unknown browser_source: $browser_source" ;;
    esac

    note "installing $browser from packages.mozilla.org"
    inchroot "install -d -m 0755 /etc/apt/keyrings"
    if ! inchroot "curl -fsSL --max-time 30 https://packages.mozilla.org/apt/repo-signing-key.gpg \
                   -o /etc/apt/keyrings/packages.mozilla.org.asc" 2>/dev/null; then
        stage_browser_fallback "packages.mozilla.org is unreachable from this build host"
        return 0
    fi
    cat > "$RFS/etc/apt/sources.list.d/mozilla.list" <<'EOL'
deb [signed-by=/etc/apt/keyrings/packages.mozilla.org.asc] https://packages.mozilla.org/apt mozilla main
EOL
    # Pin so Ubuntu's snap transitional package can never win.
    cat > "$RFS/etc/apt/preferences.d/mozilla" <<'EOL'
Package: firefox*
Pin: origin packages.mozilla.org
Pin-Priority: 1000
EOL
    if inchroot "apt-get update -qq && apt-get install -y --no-install-recommends $browser"; then
        note "$browser installed from the Mozilla apt repo (real .deb, no snap)"
    else
        # Leaving the repo configured after it failed means the first
        # `apt update` the user runs fails too, on a machine they have
        # owned for five minutes.
        rm -f "$RFS/etc/apt/sources.list.d/mozilla.list" \
              "$RFS/etc/apt/preferences.d/mozilla" \
              "$RFS/etc/apt/keyrings/packages.mozilla.org.asc"
        stage_browser_fallback "the install of $browser from the Mozilla repo failed"
    fi
}

# ── stage 3: overlay our own stack ─────────────────────────────────
stage_overlay() {
    step "stage 3/7  overlay the AurOS stack"

    install -Dm755 "$ROOT/src/aurora/aurora"       "$RFS/usr/bin/aurora"
    install -d "$RFS/usr/share/auros/themes" "$RFS/usr/share/auros/templates"
    cp "$ROOT/themes"/*.theme          "$RFS/usr/share/auros/themes/"
    cp "$ROOT/themes/templates"/*.tpl  "$RFS/usr/share/auros/templates/"

    # Archetypes. All six ship on every image so a machine can be
    # switched after the fact -- `aurshell --shell` for a try, or
    # relinking active.shell to make it stick.
    install -d "$RFS/usr/share/auros/shells"
    cp "$ROOT/shells"/*.shell "$RFS/usr/share/auros/shells/"

    # Our binaries, built against the target's glibc via the chroot so
    # they link the same way every other package on the system does.
    install -d "$RFS/usr/src/auros"
    cp -r "$ROOT/src/common" "$ROOT/src/aurinit" "$ROOT/src/aurwall" "$ROOT/src/aurshell" \
          "$ROOT/src/aurfetch" "$ROOT/src/ferry" "$ROOT/src/aurwl" "$RFS/usr/src/auros/" 2>/dev/null || true

    chroot_prep
    # The compositor needs libwayland-server and xkbcommon, and their
    # headers plus wayland-scanner and the protocol XML at build time.
    # The -dev packages and the scanner are purged again below; the two
    # shared libraries stay, because without them nothing on the desktop
    # can open a window.
    inchroot "apt-get update -qq && apt-get install -y --no-install-recommends \
              gcc libc6-dev make pkg-config \
              libwayland-dev libwayland-bin wayland-protocols libxkbcommon-dev" \
        >/dev/null 2>&1 || true
    inchroot "cd /usr/src/auros && \
        gcc -O2 -std=gnu11 -o /usr/sbin/aurinit aurinit/aurinit.c && \
        gcc -O2 -std=gnu11 -o /usr/bin/aurctl  aurinit/aurctl.c && \
        gcc -O2 -std=gnu11 -o /usr/bin/aurwall aurwall/main.c common/theme.c common/wall.c common/png.c -lm" \
        || die "building the AurOS stack inside the image failed"

    # Ferry — first-boot migration. The shell tools and data tables
    # install verbatim; the two C helpers (which parse hostile on-disk
    # data as root, hence the warning set) compile in place next to
    # them. The directory is created BEFORE the in-chroot compile that
    # writes into it.
    install -d "$RFS/usr/lib/ferry" "$RFS/usr/share/ferry"
    for t in ferry ferry-detect ferry-wifi ferry-files ferry-firefox \
             ferry-settings ferry-report ferry-hive ferry-dpapi ferry-common.sh; do
        install -Dm755 "$ROOT/src/ferry/$t" "$RFS/usr/lib/ferry/$t"
    done
    cp "$ROOT/src/ferry/data"/*.tab "$RFS/usr/share/ferry/" 2>/dev/null || true
    ln -sf /usr/lib/ferry/ferry "$RFS/usr/bin/ferry"
    inchroot "cd /usr/src/auros/ferry && \
        gcc -O2 -std=gnu11 -Wall -Wextra -o /usr/lib/ferry/ferry-hivepeek hivepeek.c && \
        gcc -O2 -std=gnu11 -Wall -Wextra -o /usr/lib/ferry/ferry-winattr  winattr.c" \
        || die "building Ferry's helpers inside the image failed"

    # aurshell needs the kernel DRM headers and libm; it links nothing else.
    # NB: do not pipe the compiler into tail here. A pipeline's exit
    # status is the last command's, so `gcc ... | tail` reports success
    # even when the compile failed -- which is exactly how a broken
    # aurshell shipped as "built" once already.
    # Every archetype is compiled in; the .shell file picks one at run
    # time. They are small, and an image that cannot switch archetype
    # without a rebuild is not the product we promised.
    # The Wayland protocol marshalling code is generated, not vendored:
    # it is a mechanical transform of XML the distribution already
    # ships, and a checked-in copy is a copy that silently goes stale
    # against the headers it is compiled with.
    # The Wayland protocol marshalling code is generated, not vendored:
    # it is a mechanical transform of XML the distribution already
    # ships, and a checked-in copy is a copy that goes stale against the
    # headers it is compiled against without anyone noticing.
    #
    # This is a hard failure rather than a fallback. There is no version
    # of this product that cannot run an application, so an image that
    # would ship without a compositor is not a lesser AurOS -- it is a
    # desktop where every icon silently does nothing, discovered by the
    # user, after the install.
    inchroot "cd /usr/src/auros/aurwl && mkdir -p gen && \
            for p in /usr/share/wayland-protocols/stable/xdg-shell/xdg-shell.xml \
                     /usr/share/wayland-protocols/unstable/xdg-decoration/xdg-decoration-unstable-v1.xml \
                     /usr/share/wayland-protocols/stable/viewporter/viewporter.xml \
                     /usr/share/wayland-protocols/unstable/xdg-output/xdg-output-unstable-v1.xml; do \
                n=\$(basename \$p .xml | sed -e 's/-unstable-v1//'); \
                wayland-scanner server-header \$p gen/\$n-server.h || exit 1; \
                wayland-scanner private-code  \$p gen/\$n-protocol.c || exit 1; \
            done" \
        || die "wayland-scanner failed: no compositor could be built"

    if inchroot "cd /usr/src/auros && gcc -O2 -std=gnu11 -o /usr/bin/aurshell \
            aurshell/main.c aurshell/draw.c aurshell/kms.c \
            aurshell/shellcommon.c aurshell/anim.c aurshell/pad.c \
            aurshell/layouts/rail.c aurshell/layouts/tiles.c \
            aurshell/layouts/locked.c aurshell/layouts/taskbar.c \
            aurshell/layouts/dock.c aurshell/layouts/workbench.c \
            aurwl/aurwl.c aurwl/gen/xdg-shell-protocol.c \
            aurwl/gen/xdg-decoration-protocol.c aurwl/gen/viewporter-protocol.c \
            aurwl/gen/xdg-output-protocol.c \
            aurshell/session.c aurshell/apps.c \
            common/theme.c common/wall.c common/font.c common/png.c \
            -I aurwl/gen -lwayland-server -lxkbcommon -lm"; then
        note "aurshell built ($(du -h "$RFS/usr/bin/aurshell" | cut -f1)), with the compositor"
    else
        die "aurshell did not build - the image would boot to a console"
    fi

    inchroot "systemctl enable auros-firstboot.service >/dev/null 2>&1" || true
    [ -x "$RFS/usr/bin/aurshell" ] && inchroot "systemctl enable aurshell.service >/dev/null 2>&1" || true

    # Headers and the code generator go; the shared libraries the shell
    # now links against must not, so they are marked manual first --
    # autoremove would otherwise take libwayland-server out from under
    # the binary that needs it and the desktop would not start.
    inchroot "apt-get install -y --no-install-recommends libwayland-server0 libxkbcommon0 >/dev/null 2>&1; \
              apt-mark manual libwayland-server0 libxkbcommon0 >/dev/null 2>&1; \
              apt-get purge -y gcc libc6-dev make pkg-config libwayland-dev libwayland-bin \
                               wayland-protocols libxkbcommon-dev >/dev/null 2>&1; \
              apt-get autoremove -y >/dev/null 2>&1" || true
    # The generated code is a build artifact; leaving it in the image
    # ships source nobody will ever compile there.
    rm -rf "$RFS/usr/src/auros/aurwl/gen"
    chroot_done
    rm -rf "$RFS/usr/src/auros"

    # First-boot and shell units.
    install -d "$RFS/etc/systemd/system"
    cp "$ROOT/rootfs/etc/systemd/system"/*.service "$RFS/etc/systemd/system/" 2>/dev/null || true
    install -Dm755 "$ROOT/rootfs/usr/lib/auros/firstboot.sh" "$RFS/usr/lib/auros/firstboot.sh"

    # ── Resolve the theme's named fonts to files the rasterizer can
    # actually read. Our engine renders TrueType `glyf` outlines; many
    # modern UI fonts (Ubuntu's Inter among them) ship as OTF with CFF
    # PostScript outlines and have no glyf table at all. Picking one of
    # those silently yields a desktop with no text, so the font is
    # verified here rather than discovered at boot.
    install -d "$RFS/usr/share/auros/fonts"
    #
    # Two things this resolver has to do that the first version could
    # not, and both are the reason the desktop had exactly one face in
    # exactly one weight:
    #
    # 1. A WEIGHT IS A FILE. The reject list below used to drop every
    #    candidate whose name contained Bold/SemiBold/Medium, which
    #    made a display face structurally unreachable no matter what a
    #    theme asked for. It now rejects weight variants only when the
    #    caller did not ask for one, and accepts a literal filename
    #    (PTF75F, IBMPlexSerif-SemiBold) when it did.
    #
    # 2. A VARIABLE FONT IS A TRAP. InterVariable.ttf and Karla[wght]
    #    carry `glyf` + `fvar` + `gvar` and no static instances. Our
    #    rasterizer ignores `fvar` entirely, so such a file LOADS,
    #    returns success, and renders the default instance at weight
    #    400 for ever. It fails by looking fine, which is worse than
    #    failing loudly, so it is refused here by name.
    resolve_font() {
        _want=$1 _link=$2 _anyweight=${3:-0}
        # Priority order matters: a plain find would happily return
        # "-Bold" before "-Regular" because B sorts before R, and the
        # whole UI would come up bold.
        if [ "$_anyweight" = 1 ]; then
            _pats="${_want}.ttf ${_want}.otf ${_want}*.ttf ${_want}*.otf"
        else
            _pats="${_want}-Regular.ttf ${_want}-Regular.otf
                   ${_want}Regular.ttf ${_want}Regular.otf
                   ${_want}.ttf ${_want}.otf
                   ${_want}-Book.ttf ${_want}*.ttf ${_want}*.otf"
        fi
        for _pat in $_pats; do
            for _cand in $(find "$RFS/usr/share/fonts" -iname "$_pat" 2>/dev/null | sort); do
                _base=$(basename "$_cand")
                # A weight variant is only wrong when nobody asked for
                # one. `font_display` asking for PT Serif Bold must not
                # be answered with PT Serif Regular.
                if [ "$_anyweight" != 1 ]; then
                    case "$_base" in
                        *Bold*|*Italic*|*Oblique*|*Light*|*Thin*|*Black*|*Medium*|*SemiBold*|*Extra*)
                            continue ;;
                    esac
                fi
                case "$_base" in *"["*|*Variable*|*VF.ttf|*VF.otf) continue ;; esac
                # The font must carry outlines our rasterizer can read.
                # It handles BOTH TrueType 'glyf' (quadratic) and
                # OpenType 'CFF ' (Type 2 charstrings, cubic), so accept
                # either. Checking matters: a font with neither -- a
                # bitmap-only or CFF2 font -- renders no text at all, and
                # a desktop with no text is not a recoverable state.
                if ! head -c 4096 "$_cand" | grep -aqE 'glyf|CFF '; then continue; fi
                # ...and it must not be a variable font wearing a glyf
                # table, for the reason above.
                if head -c 4096 "$_cand" | grep -aq 'fvar'; then
                    note "font $_base is variable (fvar); refusing -- it would render weight 400 for ever"
                    continue
                fi
                ln -sf "${_cand#"$RFS"}" "$RFS/usr/share/auros/fonts/$_link.ttf"
                note "font $_link -> $_base"
                return 0
            done
        done
        return 1
    }
    _key() { sed -n "s/^$1=\"\(.*\)\"/\1/p" "$ROOT/themes/$theme.theme" 2>/dev/null | head -1; }
    _sans=$(_key font_sans)
    _mono=$(_key font_mono)
    _disp=$(_key font_display)
    _text=$(_key font_text)
    _tbold=$(_key font_text_bold)
    resolve_font "${_sans:-Inter}" "${_sans:-Inter}" || {
        note "WARNING: '${_sans:-Inter}' has no TrueType outlines here; using DejaVu Sans"
        resolve_font DejaVuSans "${_sans:-Inter}" || true
    }
    resolve_font "${_mono:-JetBrainsMono}" "${_mono:-JetBrainsMono}" || {
        note "WARNING: '${_mono:-JetBrainsMono}' unavailable; using DejaVu Sans Mono"
        resolve_font DejaVuSansMono "${_mono:-JetBrainsMono}" || true
    }
    # The three shell faces. Each falls back to the text face, then to
    # Clear Sans, then to DejaVu -- never to nothing, because a desktop
    # with no text is not a recoverable state. Weight-qualified names
    # are allowed here (third argument), which is the whole point.
    for _slot in "${_disp:-}" "${_text:-}" "${_tbold:-}"; do
        [ -n "$_slot" ] || continue
        resolve_font "$_slot" "$_slot" 1 || {
            note "WARNING: font '$_slot' not found; falling back"
            resolve_font ClearSans-Regular "$_slot" 1 ||
            resolve_font DejaVuSans "$_slot" || true
        }
    done

    install -d "$RFS/etc/auros/services"
    cp "$ROOT/rootfs/etc/auros/services"/*.service "$RFS/etc/auros/services/" 2>/dev/null || true
    note "aurinit, aurctl, aurwall, aurora, ferry installed"
}

# ── stage 4: identity, locale, users, policy ───────────────────────
stage_configure() {
    step "stage 4/7  configure"
    chroot_prep

    # On Ubuntu /etc/os-release is a symlink into /usr/lib, so the real
    # file is written there and /etc just points at it. Writing through
    # the symlink and then replacing it is how you end up with a
    # dangling /etc/os-release and a system that cannot name itself.
    rm -f "$RFS/etc/os-release"
    mkdir -p "$RFS/usr/lib"
    cat > "$RFS/usr/lib/os-release" <<EOL
NAME="$brand_name"
PRETTY_NAME="$brand_name $os_version"
ID=$brand_short
ID_LIKE=ubuntu
VERSION="$os_version ($os_codename)"
VERSION_ID="$os_version"
VERSION_CODENAME=$os_codename
HOME_URL="$brand_url"
LOGO=auros
EOL
    ln -sf ../usr/lib/os-release "$RFS/etc/os-release"
    echo "$brand_short" > "$RFS/etc/hostname"

    # Branding the login prompts. Without this the first thing a user
    # sees after install is "Ubuntu 24.04 LTS", which is both confusing
    # and a promise we did not make.
    printf '%s %s \\n \\l\n\n' "$brand_name" "$os_version" > "$RFS/etc/issue"
    printf '%s %s\n' "$brand_name" "$os_version" > "$RFS/etc/issue.net"
    : > "$RFS/etc/motd"
    # Ubuntu's dynamic MOTD advertises Ubuntu Pro and Landscape.
    for f in 10-help-text 50-motd-news 88-esm-announce 91-contract-ua-esm-status 91-release-upgrade; do
        rm -f "$RFS/etc/update-motd.d/$f"
    done
    [ -d "$RFS/etc/update-motd.d" ] && cat > "$RFS/etc/update-motd.d/00-auros" <<'EOM'
#!/bin/sh
[ -f /etc/auros/motd ] && cat /etc/auros/motd
EOM
    [ -f "$RFS/etc/update-motd.d/00-auros" ] && chmod +x "$RFS/etc/update-motd.d/00-auros"

    printf '127.0.0.1\tlocalhost\n127.0.1.1\t%s\n' "$brand_short" > "$RFS/etc/hosts"

    inchroot "ln -sf /usr/share/zoneinfo/$timezone /etc/localtime" || true
    echo "$locale UTF-8" > "$RFS/etc/locale.gen"
    for l in ${extra_locales:-}; do echo "$l UTF-8" >> "$RFS/etc/locale.gen"; done
    inchroot "locale-gen >/dev/null 2>&1" || true
    echo "LANG=$locale" > "$RFS/etc/default/locale"
    cat > "$RFS/etc/default/keyboard" <<EOL
XKBMODEL="pc105"
XKBLAYOUT="$keyboard_layout"
XKBVARIANT="${keyboard_variant:-}"
BACKSPACE="guess"
EOL

    inchroot "id -u $default_user >/dev/null 2>&1 || useradd -m -s /bin/bash -G sudo,audio,video,netdev $default_user"
    # Placeholder credential. First boot forces a change; a shipped
    # image must never carry a usable password.
    inchroot "echo '$default_user:auros' | chpasswd; passwd -e $default_user" || true
    inchroot "passwd -l root" || true

    # The archetype. This one symlink decides how the whole computer
    # behaves; everything else in this stage only decides how it looks.
    install -d "$RFS/etc/auros/shell"
    if [ -f "$RFS/usr/share/auros/shells/${shell_archetype}.shell" ]; then
        ln -sf "/usr/share/auros/shells/${shell_archetype}.shell" \
               "$RFS/etc/auros/shell/active.shell"
        note "archetype: $shell_archetype"
    else
        ln -sf "/usr/share/auros/shells/rail.shell" \
               "$RFS/etc/auros/shell/active.shell"
        note "archetype '$shell_archetype' not found - falling back to rail"
    fi

    # The policy file is what aurshell and the settings app consult.
    # Lockdown is enforced by the shell reading this, not by hiding menus.
    install -d "$RFS/etc/auros"
    cat > "$RFS/etc/auros/policy.conf" <<EOL
# Generated by forge from profile '$profile_id'. Machine-readable policy.
profile              = $profile_id
shell_archetype      = ${shell_archetype:-rail}
kiosk_mode           = $kiosk_mode
allowed_apps         = ${allowed_apps:-}
blocked_apps         = ${blocked_apps:-}
allow_user_install   = $allow_user_install
allow_settings_change= $allow_settings_change
allow_theme_change   = $allow_theme_change
allow_tty            = $allow_tty
auto_login           = $auto_login
default_user         = $default_user
enrollment_url       = ${enrollment_url:-}
update_channel       = ${update_channel:-stable}
telemetry            = ${telemetry:-off}
EOL

    if [ "$allow_tty" = "no" ]; then
        inchroot "systemctl mask getty@tty2.service getty@tty3.service getty@tty4.service \
                  getty@tty5.service getty@tty6.service >/dev/null 2>&1" || true
        note "virtual consoles disabled (kiosk policy)"
    fi
    if [ "$allow_user_install" = "no" ]; then
        cat > "$RFS/etc/sudoers.d/90-auros-lockdown" <<'EOL'
# Kiosk policy: users may not install or remove software.
%users ALL=(ALL) !/usr/bin/apt, !/usr/bin/apt-get, !/usr/bin/dpkg, !/usr/bin/aur
EOL
        chmod 440 "$RFS/etc/sudoers.d/90-auros-lockdown"
    fi

    chroot_done
    note "identity: $brand_name $os_version ($os_codename), locale $locale, kiosk=$kiosk_mode"
}

# ── stage 5: theme ─────────────────────────────────────────────────
stage_theme() {
    step "stage 5/7  theme: $theme"
    chroot_prep
    inchroot "aurora set $theme" || die "aurora could not apply '$theme'"
    inchroot "aurwall --conf /etc/auros/shell.conf --out /usr/share/auros/wallpaper.png \
              --width 1920 --height 1080 >/dev/null 2>&1" || note "wallpaper deferred to first boot"
    inchroot "grep -q auros /etc/profile || echo '[ -f /etc/auros/prompt.sh ] && . /etc/auros/prompt.sh' >> /etc/profile" || true
    inchroot "grep -q auros-motd /etc/profile || echo '[ -f /etc/auros/motd ] && cat /etc/auros/motd  # auros-motd' >> /etc/profile" || true
    chroot_done
}

# ── stage 6: squashfs ──────────────────────────────────────────────
stage_squash() {
    step "stage 6/7  compress"
    mkdir -p "$OUT"
    local sq="$OUT/$profile_id-$os_version.squashfs"
    rm -f "$sq"
    mksquashfs "$RFS" "$sq" -comp zstd -Xcompression-level 15 -noappend -quiet \
        -e "$RFS/.forge-bootstrapped"
    note "$(basename "$sq")  $(du -h "$sq" | cut -f1)"
}

# ── stage 7: bootable artifacts ────────────────────────────────────
stage_image() {
    step "stage 7/7  bootable image"
    note "handled by build/mkimage (raw image for AurBridge) — see docs/AURBRIDGE.md"
}

run_stage() {
    case $1 in
        1) stage_bootstrap ;; 2) stage_packages ;; 3) stage_overlay ;;
        4) stage_configure ;; 5) stage_theme ;; 6) stage_squash ;;
        7) stage_image ;;
        *) die "no such stage: $1" ;;
    esac
}

case "${1:-}" in
    build)
        load_profile "${2:?usage: forge build PROFILE}"
        say "forging '$profile_name' ($profile_id)"
        for s in 1 2 3 4 5 6 7; do run_stage $s; done
        printf '\n%s::%s %s is built.\n' "$C_OK" "$C_RST" "$brand_name $os_version" ;;
    stage)
        load_profile "${2:?usage: forge stage PROFILE N}"
        run_stage "${3:?which stage?}" ;;
    shell)
        load_profile "${2:?usage: forge shell PROFILE}"
        chroot_prep; chroot "$RFS" /bin/bash || true; chroot_done ;;
    clean)
        load_profile "${2:?usage: forge clean PROFILE}"
        chroot_done 2>/dev/null || true
        rm -rf "${WORK:?}/$profile_id"; say "cleaned $profile_id" ;;
    list)
        for f in "$PROFILE_DIR"/*.profile; do
            [ -f "$f" ] || continue
            n=$(basename "$f" .profile)
            d=$(sed -n 's/^profile_description="\(.*\)"/\1/p' "$f" | head -1)
            printf '  %-16s %s\n' "$n" "$d"
        done ;;
    *)
        cat <<EOU
forge — the AurOS image builder

  forge build PROFILE       build a complete image
  forge stage PROFILE N     run a single stage (1-7)
  forge shell PROFILE       chroot into the built rootfs
  forge clean PROFILE       remove the work tree
  forge list                list profiles

Profiles live in $PROFILE_DIR
EOU
        ;;
esac
