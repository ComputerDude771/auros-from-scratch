#!/bin/sh
# ═══════════════════════════════════════════════════════════════════
#  aurbridge — build the Windows half of the installer
#
#  Two binaries out of one set of sources:
#
#    aurbridge.exe          the console tool. `preflight` returns 0 for
#                           go and 1 for blocked, which CI depends on.
#    aurbridge-wizard.exe   the thing a person double-clicks.
#
#  WHY A SCRIPT RATHER THAN THE COMMENT IT REPLACES. The build line
#  lived in a comment at the top of wizard.c, which means it was right
#  until the day somebody added a source file. The phase engine is a
#  new translation unit and that day is today.
#
#    ./build/aurbridge            build both
#    ./build/aurbridge test       build, then run the console tool
#                                 under wine as far as wine will go
# ═══════════════════════════════════════════════════════════════════
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SRC="$ROOT/src/aurbridge"
OUT="$ROOT/out"
CC="${CC:-x86_64-w64-mingw32-gcc}"

C_OK=$(printf '\033[38;2;125;211;192m'); C_DIM=$(printf '\033[38;2;110;120;134m')
C_ERR=$(printf '\033[38;2;242;120;141m'); C_RST=$(printf '\033[0m')
step() { printf '\n%s▸%s %s\n' "$C_OK" "$C_RST" "$*"; }
note() { printf '%s   %s%s\n' "$C_DIM" "$*" "$C_RST"; }
die()  { printf '%s::%s %s\n' "$C_ERR" "$C_RST" "$*" >&2; exit 1; }

command -v "$CC" >/dev/null 2>&1 || die "no $CC — install mingw-w64"
mkdir -p "$OUT"

# Every .c in the directory except the two that hold a main(). A source
# file left out of a hand-written list still links, and the checks it
# was written to perform simply do not happen -- the staging build
# learned that the expensive way.
# THE RULE IS IN THE FILE NAMES, so a new source file lands in the
# right binary without anybody remembering to edit this:
#
#   main.c, wizard.c   have a main() of their own
#   *_win.c            Windows only
#   *_sim.c, simmain.c the host-side simulation only, never shipped
#
# Everything else is shared. A hand-written list is how a file gets
# left out and the checks in it simply do not happen; a rule is at
# least wrong in a way somebody can see.
LIB=""; WINONLY=""; SIMONLY=""
for f in "$SRC"/*.c; do
    b=$(basename "$f")
    case "$b" in
      main.c|wizard.c)   continue ;;
      simmain.c|*_sim.c) SIMONLY="$SIMONLY $f"; continue ;;
      *_win.c)           WINONLY="$WINONLY $f"; continue ;;
    esac
    LIB="$LIB $f"
done
note "shared:$(echo "$LIB" | sed "s|$SRC/||g")"
note "windows:$(echo "$WINONLY" | sed "s|$SRC/||g")"
note "simulated:$(echo "$SIMONLY" | sed "s|$SRC/||g")"
LIB="$LIB $WINONLY"

# -municode is NOT used: main.c is a plain main() and the wizard has
# its own WinMain. Unicode comes from the W-suffixed APIs, which is
# the only way that works the same on Windows 7 and 11.
WARN="-Wall -Wextra -Wno-unused-parameter -std=gnu11"

# ── what this installer carries and where it fetches from ──────────
#
# ONE FILE SOMEBODY DOUBLE-CLICKS. It was three: the wizard, plus a
# kernel and an initramfs that had to be sitting in the same folder,
# and a person who downloads one of three and double-clicks it is told
# "the copy of AurOS to install could not be found" -- a true sentence
# about a mistake we made.
#
# The staging environment is about 28 MB, which is an ordinary size for
# an installer, so it goes INSIDE the executable as a PE resource --
# the mechanism Authenticode already covers, so carrying a payload and
# being signed do not fight. The image is five gigabytes and does not
# go inside anything, so its address and its hash are baked in instead
# and the installer downloads it, resuming.
#
# Both are optional here. A developer build with neither produces the
# arrangement this product had before -- everything beside the exe --
# and says so; AUROS_RELEASE=1 refuses that, because an installer that
# tells a stranger to go and find two more files is not the product.
KERNEL="${AUROS_STAGING_KERNEL:-$OUT/auros-staging-vmlinuz}"
INITRD="${AUROS_STAGING_INITRD:-$OUT/auros-staging.img}"
# The signed way in: see build/staging and phase_handoff in phases.c.
SHIMEFI="${AUROS_STAGING_SHIM:-$OUT/auros-staging-shimx64.efi}"
GRUBEFI="${AUROS_STAGING_GRUB:-$OUT/auros-staging-grubx64.efi}"
MOKMEFI="${AUROS_STAGING_MOKMGR:-$OUT/auros-staging-mmx64.efi}"
IMGDEF=""
[ -n "${AUROS_IMAGE_URL:-}" ] && \
    IMGDEF="$IMGDEF -DAUROS_IMAGE_URL=\"$AUROS_IMAGE_URL\""
[ -n "${AUROS_IMAGE_SHA256:-}" ] && \
    IMGDEF="$IMGDEF -DAUROS_IMAGE_SHA256=\"$AUROS_IMAGE_SHA256\""
[ -n "${AUROS_IMAGE_BYTES:-}" ] && \
    IMGDEF="$IMGDEF -DAUROS_IMAGE_BYTES=${AUROS_IMAGE_BYTES}ULL"

# ── where the image is published in pieces ─────────────────────────
#
# AUROS_IMAGE_PIECES names a piece list (src/aurbridge/phases.h has the
# format). It is baked into the wizard as a C string in a generated
# header, and the header is written on EVERY build -- empty when there
# is no list -- so a list from yesterday's build cannot ride along in
# today's. The characters are checked first: this text becomes C source.
BAKED="$OUT/aurbridge-baked.h"
{
    printf '/* generated by build/aurbridge; do not edit */\n'
    printf '#define AUROS_PIECES_TEXT \\\n'
    if [ -n "${AUROS_IMAGE_PIECES:-}" ]; then
        [ -f "$AUROS_IMAGE_PIECES" ] || die "AUROS_IMAGE_PIECES=$AUROS_IMAGE_PIECES is not a file"
        if LC_ALL=C grep -q '[^A-Za-z0-9 ._:/#,+-]' "$AUROS_IMAGE_PIECES"; then
            die "the piece list has characters in it that do not belong in an
     address, a file name or a hash; refusing to bake it into C"
        fi
        [ -n "${AUROS_IMAGE_SHA256:-}" ] && [ -n "${AUROS_IMAGE_BYTES:-}" ] \
            || die "AUROS_IMAGE_PIECES is set without AUROS_IMAGE_SHA256 and
     AUROS_IMAGE_BYTES. The pieces are checked one by one; what they unpack
     to is checked against those two, and without them it would not be."
        while IFS= read -r line; do printf '    "%s\\n" \\\n' "$line"; done \
            < "$AUROS_IMAGE_PIECES"
    fi
    printf '    ""\n'
} > "$BAKED"
[ -n "${AUROS_IMAGE_PIECES:-}" ] && \
    note "the image is fetched in $(grep -c '^piece ' "$AUROS_IMAGE_PIECES") pieces"

PAYLOAD_OBJ=""
if [ -f "$KERNEL" ] && [ -f "$INITRD" ]; then
    step "the staging environment, into the executable"
    RC="$OUT/aurbridge-payload.rc"
    # windres reads the file names out of the .rc, so they are written
    # as absolute paths and the ids are the two plat.h knows about.
    # RCDATA is 10; naming it numerically means nothing has to agree
    # about a string.
    {
        printf '1 10 "%s"\n' "$KERNEL"
        printf '2 10 "%s"\n' "$INITRD"
        if [ -f "$SHIMEFI" ] && [ -f "$GRUBEFI" ]; then
            printf '3 10 "%s"\n' "$SHIMEFI"
            printf '4 10 "%s"\n' "$GRUBEFI"
            [ -f "$MOKMEFI" ] && printf '5 10 "%s"\n' "$MOKMEFI"
        fi
    } > "$RC"
    if [ -f "$SHIMEFI" ] && [ -f "$GRUBEFI" ]; then
        # A shim somebody other than Microsoft signed is a shim no
        # firmware with Secure Boot on will start. Asked of the file,
        # when there is something to ask with.
        if command -v sbverify >/dev/null 2>&1; then
            sbverify --list "$SHIMEFI" 2>/dev/null | grep -q 'Microsoft' \
                || die "$SHIMEFI is not signed by Microsoft; it would not start
     on a machine with Secure Boot on"
        fi
        note "and the signed shim and grub that start it with Secure Boot on"
    elif [ "${AUROS_RELEASE:-0}" = 1 ]; then
        die "no signed shim and grub to carry (run ./build/staging), so the
     installer would not start on a machine with Secure Boot on"
    else
        note "NOT carried: signed shim and grub. This build works only with"
        note "Secure Boot off; a release build refuses to be made this way."
    fi
    WINDRES="${WINDRES:-x86_64-w64-mingw32-windres}"
    command -v "$WINDRES" >/dev/null 2>&1 \
        || die "no $WINDRES — install mingw-w64 (binutils)"
    "$WINDRES" -O coff -i "$RC" -o "$OUT/aurbridge-payload.o" \
        || die "the staging environment could not be put into the installer"
    PAYLOAD_OBJ="$OUT/aurbridge-payload.o"
    note "$(du -h "$KERNEL" | cut -f1) kernel + $(du -h "$INITRD" | cut -f1) initramfs"
else
    note "no staging environment to embed (run ./build/staging first)"
fi

# ── the wizard's manifest: ask for administrator rights up front ────
# See src/aurbridge/aurbridge.manifest for why. The console tool is left
# without one: it is what CI and a person at a prompt run, and preflight
# already says plainly when it is not elevated.
WINDRES="${WINDRES:-x86_64-w64-mingw32-windres}"
MANIFEST_OBJ=""
if command -v "$WINDRES" >/dev/null 2>&1; then
    printf '1 24 "%s"\n' "$SRC/aurbridge.manifest" > "$OUT/aurbridge-manifest.rc"
    "$WINDRES" -O coff -i "$OUT/aurbridge-manifest.rc" -o "$OUT/aurbridge-manifest.o" \
        || die "the wizard's manifest would not build"
    MANIFEST_OBJ="$OUT/aurbridge-manifest.o"
elif [ "${AUROS_RELEASE:-0}" = 1 ]; then
    die "no $WINDRES, so the wizard would not ask for administrator rights"
fi

step "aurbridge.exe (console)"
# shellcheck disable=SC2086
$CC -O2 $WARN $IMGDEF -o "$OUT/aurbridge.exe" "$SRC/main.c" $LIB $PAYLOAD_OBJ \
    -lwinhttp \
    || die "the console tool did not build"
note "$(du -h "$OUT/aurbridge.exe" | cut -f1)"

step "aurbridge-wizard.exe"
# shellcheck disable=SC2086
$CC -O2 $WARN $IMGDEF -I "$OUT" -mwindows -o "$OUT/aurbridge-wizard.exe" \
    "$SRC/wizard.c" $LIB $PAYLOAD_OBJ $MANIFEST_OBJ \
    -lgdi32 -lcomctl32 -lwinhttp \
    || die "the wizard did not build"
note "$(du -h "$OUT/aurbridge-wizard.exe" | cut -f1)"

# ── the host-side simulation ───────────────────────────────────────
#
# out/aurbridge-sim runs the SAME phase engine against a computer made
# of files, so that the memory stick and the journal the installer is
# tested with are the ones AurBridge produces rather than ones a test
# wrote to match. It is built with the host compiler and is never
# shipped -- and the build refuses to put a simulated platform into a
# Windows binary, which is the one way this could go badly wrong.
step "aurbridge-sim (not shipped)"
HOSTCC="${HOSTCC:-cc}"
if command -v "$HOSTCC" >/dev/null 2>&1; then
    SIMLIB=""
    for f in "$SRC"/format.c "$SRC"/phases.c "$SRC"/inflate.c; do SIMLIB="$SIMLIB $f"; done
    # shellcheck disable=SC2086
    $HOSTCC -O2 $WARN -o "$OUT/aurbridge-sim" $SIMLIB $SIMONLY \
        || die "the simulation did not build"
    note "$(du -h "$OUT/aurbridge-sim" | cut -f1)"
else
    note "no host compiler; skipped"
fi

# And the gate: no simulated platform may be inside anything shipped.
for exe in "$OUT/aurbridge.exe" "$OUT/aurbridge-wizard.exe"; do
    if strings "$exe" 2>/dev/null | grep -q 'a simulated computer made of files'; then
        die "$(basename "$exe") contains the simulated platform. A shipped
     binary that can pretend to write to a disk is the worst thing in
     this tree; refusing to publish it."
    fi
done
note "neither shipped binary contains the simulation"

# ── the name on the front ──────────────────────────────────────────
#
# SmartScreen puts a full-screen panel in front of an unsigned
# executable downloaded from the internet, and its only visible button
# says "Don't run". For this product that is not a rough edge: it is
# the people it was built for being unable to start it, and the people
# who get past it having just been taught to ignore a warning before
# handing a program their whole disk.
#
# So a release does not get built without a signature. A developer
# build says what is missing and carries on, because requiring a
# hardware token to compile is how nobody compiles.
# ── what a release must carry ──────────────────────────────────────
step "checking what this installer carries"
if [ -n "$PAYLOAD_OBJ" ]; then
    note "the staging environment is inside both binaries"
elif [ "${AUROS_RELEASE:-0}" = 1 ]; then
    die "this is a release build and the installer carries no staging
     environment, so it would tell a stranger to go and find two more
     files. Run ./build/staging first."
else
    note "NOT carried: a release build will refuse this"
fi
if [ -n "${AUROS_IMAGE_PIECES:-}" ]; then
    note "it will fetch the image in pieces from $(sed -n 's/^base //p' "$AUROS_IMAGE_PIECES" | head -1)"
elif [ -n "${AUROS_IMAGE_URL:-}" ]; then
    [ -n "${AUROS_IMAGE_SHA256:-}" ] \
        || die "AUROS_IMAGE_URL is set and AUROS_IMAGE_SHA256 is not.
     An installer that downloads five gigabytes and cannot say what they
     should be is an installer that will write anything it is handed."
    # AND HOW BIG IT WILL BE, because phase 0 asks whether the memory
    # stick is large enough before there is a file to measure. Without
    # this it guesses six gigabytes and then quotes the guess to the
    # user in megabytes -- so somebody with a stick between the real
    # figure and the guess is told, precisely and falsely, to go and
    # buy a larger one.
    [ -n "${AUROS_IMAGE_BYTES:-}" ] \
        || die "AUROS_IMAGE_URL is set and AUROS_IMAGE_BYTES is not.
     Phase 0 has to know how much room the memory stick needs before the
     image has been downloaded, and a guess is a refusal with a number
     in it that is not true."
    note "it will fetch the image from $AUROS_IMAGE_URL"
elif [ "${AUROS_RELEASE:-0}" = 1 ]; then
    die "this is a release build and no AUROS_IMAGE_URL was given, so
     the installer would expect a five gigabyte file to be sitting
     beside it. Set AUROS_IMAGE_URL and AUROS_IMAGE_SHA256."
else
    note "no image address: it will expect one beside itself"
fi

step "signing"
if sh "$ROOT/build/sign" --configured 2>/dev/null; then
    sh "$ROOT/build/sign" "$OUT/aurbridge.exe" "$OUT/aurbridge-wizard.exe" \
        || die "the installer could not be signed"
elif [ "${AUROS_RELEASE:-0}" = 1 ]; then
    die "this is a release build and there is nothing to sign with, so
     refusing to publish an unsigned installer. Windows will put a
     full-screen warning in front of it whose only visible button says
     Don't run. See docs/SIGNING.md for what has to be bought."
else
    note "not signed: no signing material configured (see docs/SIGNING.md)"
    note "a release build -- AUROS_RELEASE=1 -- will refuse to finish this way"
fi

if [ "${1:-}" = "test" ]; then
    step "self-test"
    # WHAT WINE CAN AND CANNOT SAY. It has no real disks, no BitLocker,
    # no BCD store and no firmware variables, so a preflight run under
    # it exercises the parsing, the report and the exit-code contract
    # and nothing about a real machine. That is still worth running on
    # every build: it is the difference between "it compiles" and "it
    # starts".
    if command -v wine >/dev/null 2>&1; then
        WINEDEBUG=-all wine "$OUT/aurbridge.exe" selftest 2>/dev/null \
            && note "selftest passed under wine" \
            || note "selftest did not pass under wine (it may need a real machine)"
    else
        note "no wine here; skipped"
    fi
    # The part that does not need a machine at all, and is where the
    # bytes both halves depend on are actually checked.
    sh "$ROOT/tools/bridgetest.sh" || die "the two halves disagree"
fi

printf '\n%s::%s %s\n' "$C_OK" "$C_RST" "$OUT/aurbridge.exe, $OUT/aurbridge-wizard.exe"
