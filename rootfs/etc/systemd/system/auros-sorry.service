[Unit]
Description=AurOS: telling the user the desktop did not start
# Reached only from aurshell.service's OnFailure=, which fires after
# systemd has given up restarting the shell.
#
# It used to be OnFailure=getty@tty1.service, above a comment saying
# that was better than leaving the user with a black screen and no way
# in. It WAS better. It was also a login prompt on a machine whose
# owner has never been told the account name, has never been told the
# password, and whose password this image expires on purpose. A black
# screen and a console she cannot use are the same screen to her --
# and docs/EASY.md rule 1 says no path in this product may bottom out
# at a command line.
#
# Conflicts with the shell, and that is the load-bearing line.
#
# The first version of this did not have it, and the journal of a
# deliberately broken image showed what happened instead:
#
#   15:02:36  Starting auros-sorry.service
#   15:02:38  aurshell.service: Scheduled restart job, counter at 1
#   15:02:38  Started aurshell.service
#   15:02:38  auros-sorry.service: Main process exited, killed, HUP
#
# The shell's own Restart= brought it back two seconds later, its
# TTYVHangup=yes hung up tty1, and that killed the screen explaining
# why the shell was not running. Then it failed again, and the whole
# thing looped every two seconds, forever, showing her a flickering
# black screen -- worse than the login prompt it replaced.
Conflicts=aurshell.service getty@tty1.service
After=aurshell.service getty@tty1.service

[Service]
Type=oneshot
ExecStart=/usr/bin/aursorry
# And then try the desktop again, which is what makes the sentence on
# that screen -- "the computer is going to try again on its own" --
# true rather than consoling. reset-failed first, because systemd will
# not start a unit it has already given up on.
#
# reset-failed is also why the loop above was infinite rather than
# self-limiting: it clears the restart counter, so the shell's start
# limit was never reached and systemd never stopped retrying. It is
# still needed -- but it belongs here, AFTER the message has been on
# the screen for its full time, not two seconds into it.
ExecStopPost=/bin/sh -c 'systemctl reset-failed aurshell.service; systemctl --no-block start aurshell.service'
# NO TTY. This program has no input and wants no controlling terminal:
# taking tty1 is what put it in the path of the shell's vhangup.
StandardInput=null
StandardOutput=journal
StandardError=journal
