<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  The wizard's application manifest, linked in by build/aurbridge.

  requireAdministrator, because every check preflight makes reads the raw
  disk and the firmware, and without it a double-click landed on a refusal
  page whose remedy was "right-click and choose Run as administrator" --
  a step the people this is for do not know exists. With it, Windows asks
  the ordinary "do you want to allow this app" question before the window
  opens. (Windows' installer-detection heuristic would have done this for
  a 32-bit program called "setup"; it never applies to a 64-bit one.)

  supportedOS for 7 through 11, so that Windows does not run the program
  under compatibility shims for an older version than the one it is on.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="AurOS.AurBridge" version="0.1.0.0"
                    processorArchitecture="amd64"/>
  <description>AurBridge - install AurOS beside Windows</description>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
